{
  "name": "@xiaoli-ui/theme",
  "version": "0.1.0",
  "description": "Xiaoli UI shared CSS, presets and theme helpers",
  "type": "module",
  "license": "MIT",
  "sideEffects": ["**/*.css"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist", "README.md", "LICENSE"],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./base.css": "./dist/base.css",
    "./tokens.css": "./dist/tokens.css",
    "./button/style.css": "./dist/components/button.css",
    "./icon/style.css": "./dist/components/icon.css",
    "./flex/style.css": "./dist/components/flex.css",
    "./input/style.css": "./dist/components/input.css",
    "./checkbox/style.css": "./dist/components/checkbox.css",
    "./form/style.css": "./dist/components/form.css",
    "./dialog/style.css": "./dist/components/dialog.css",
    "./toast/style.css": "./dist/components/toast.css",
    "./card/style.css": "./dist/components/card.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx ../../scripts/build-theme.ts"
  },
  "dependencies": {
    "@xiaoli-ui/tokens": "workspace:*"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "keywords": ["css", "theme", "design-system", "xiaoli-ui"],
  "homepage": "https://github.com/LI1999YT/xiaoli-ui/tree/main/packages/theme",
  "bugs": {
    "url": "https://github.com/LI1999YT/xiaoli-ui/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/LI1999YT/xiaoli-ui.git",
    "directory": "packages/theme"
  }
}
