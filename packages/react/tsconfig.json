{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "noEmit": true,
    "paths": {
      "@xiaoli-ui/tokens": ["../tokens/src/index.ts"],
      "@xiaoli-ui/theme": ["../theme/src/index.ts"],
      "@xiaoli-ui/internal-core": ["../internal-core/src/index.ts"],
      "@xiaoli-ui/internal-dom": ["../internal-dom/src/index.ts"]
